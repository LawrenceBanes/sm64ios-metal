{
  "formatVersion": 2,
  "id": "GraphDemo",
  "name": "Graph Demo",
  "author": "SHITBOX LABZ INC.",
  "version": "0.1.0",
  "shaderApiVersion": 2,
  "stage": "render_graph",
  "parameters": [
    { "name": "levels", "label": "Color levels", "type": "float", "default": 6, "min": 2, "max": 16 },
    { "name": "quantize", "label": "Quantization", "type": "float", "default": 0.55, "min": 0, "max": 1 },
    { "name": "warmth", "label": "Warm finish", "type": "float", "default": 0.35, "min": 0, "max": 1 },
    { "name": "characterTint", "label": "Character tint", "type": "float", "default": 0.65, "min": 0, "max": 1 }
  ],
  "materialShader": { "source": "shaders/material.metal" },
  "passes": [
    { "id": "quantize", "type": "fullscreen", "input": "sceneColor", "output": "graded", "source": "shaders/quantize.metal", "scale": 0.5 },
    { "id": "warm_finish", "type": "fullscreen", "input": "graded", "output": "present", "source": "shaders/warm_finish.metal", "scale": 1.0 }
  ]
}
