{
  "formatVersion": 2,
  "id": "DepthCompute64",
  "name": "Depth Compute 64",
  "author": "SHITBOX LABZ INC.",
  "version": "0.1.0",
  "shaderApiVersion": 2,
  "stage": "render_graph",
  "parameters": [
    { "name": "fog", "label": "Depth fog", "type": "float", "default": 0.25, "min": 0, "max": 1 }
  ],
  "passes": [
    { "id": "depth_fog", "type": "compute", "input": "sceneColor", "output": "fogged", "source": "shaders/fog.metal", "scale": 0.5, "sceneDepth": true },
    { "id": "present", "type": "fullscreen", "input": "fogged", "output": "present", "source": "shaders/present.metal", "scale": 1.0 }
  ]
}
