{
  "formatVersion": 2,
  "id": "ComputeBlur64",
  "name": "Compute Blur 64",
  "author": "SHITBOX LABZ INC.",
  "version": "0.1.0",
  "shaderApiVersion": 2,
  "stage": "render_graph",
  "parameters": [
    { "name": "blur", "label": "Blur amount", "type": "float", "default": 0.75, "min": 0, "max": 1 }
  ],
  "passes": [
    { "id": "compute_blur", "type": "compute", "input": "sceneColor", "output": "blurred", "source": "shaders/blur.metal", "scale": 0.5 },
    { "id": "present_blur", "type": "fullscreen", "input": "blurred", "output": "present", "source": "shaders/present.metal", "scale": 1.0 }
  ]
}
