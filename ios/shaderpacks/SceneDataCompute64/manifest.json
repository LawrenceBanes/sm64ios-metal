{
  "formatVersion": 2,
  "id": "SceneDataCompute64",
  "name": "Lit Scene Data Compute 64",
  "author": "SHITBOX LABZ INC.",
  "version": "0.1.0",
  "shaderApiVersion": 2,
  "stage": "render_graph",
  "textures": [
    { "id": "checker", "source": "textures/checker.png" }
  ],
  "parameters": [
    { "name": "textureMix", "label": "Texture mix", "type": "float", "default": 0.15, "min": 0, "max": 1 },
    { "name": "fog", "label": "Depth fog", "type": "float", "default": 0.2, "min": 0, "max": 1 }
  ],
  "passes": [
    { "id": "surface_data", "type": "compute", "input": "sceneColor", "output": "surface", "source": "shaders/surface.metal", "scale": 0.5, "sceneDepth": true, "sceneNormals": true, "sceneLighting": true, "packTextures": true },
    { "id": "present", "type": "fullscreen", "input": "surface", "output": "present", "source": "shaders/present.metal", "scale": 1.0 }
  ]
}
