{
  "formatVersion": 2,
  "id": "DepthNormalsCompute64",
  "name": "Depth + Normals Compute 64",
  "author": "SHITBOX LABZ INC.",
  "version": "0.1.0",
  "shaderApiVersion": 2,
  "stage": "render_graph",
  "parameters": [
    { "name": "fog", "label": "Distance blend", "type": "float", "default": 0.25, "min": 0, "max": 1 }
  ],
  "passes": [
    { "id": "surface_shade", "type": "compute", "input": "sceneColor", "output": "shaded", "source": "shaders/surface.metal", "scale": 0.5, "sceneDepth": true, "sceneNormals": true },
    { "id": "present", "type": "fullscreen", "input": "shaded", "output": "present", "source": "shaders/present.metal", "scale": 1.0 }
  ]
}
