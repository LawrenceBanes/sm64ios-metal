+- (void)applicationWindowSceneDidConnect:(NSNotification *)notification
+{
+#if !TARGET_OS_TV
+    if ([notification.object isKindOfClass:[UIWindowScene class]] &&
+        [((UIWindowScene *)notification.object).session.role isEqualToString:UIWindowSceneSessionRoleApplication]) {
+        hasConnectedApplicationScene = YES;
+        gfx_ios_diag_log("SDL UIKit scene-ready notification received scene=%s", ((UIWindowScene *)notification.object).session.persistentIdentifier.UTF8String);
+        NSLog(@"SDL_main released after UIWindowScene connection: %@", ((UIWindowScene *)notification.object).session.persistentIdentifier);
+        [self performSelector:@selector(startSDLMainWhenSceneIsReady) withObject:nil afterDelay:0.0];
+    }
+#else
+    (void)notification;
+#endif
+}
