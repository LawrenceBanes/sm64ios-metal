+        if (!hasConnectedApplicationScene) {
+            gfx_ios_diag_log("SDL UIKit launch sequence deferred: scene connection callback has not arrived; returning to UIKit run loop");
+            NSLog(@"Deferring SDL_main until the application UIWindowScene connects");
